# Copy to .env and adjust (see README "Choosing a model").
# Defaults tuned for: Ryzen 7 7445HS, 20 GB RAM, RTX 3050 Laptop 6 GB VRAM.

# LLM served by Ollama on the GPU (4-bit quantized)
#   llama3.2:1b  ~1.3 GB VRAM  fastest, weakest
#   llama3.2:3b  ~2.0 GB VRAM  default: good balance on 6 GB
#   llama3.1:8b  ~4.9 GB VRAM  fits alone in 6 GB, slower - episode 3 comparison
LLM_MODEL=llama3.2:3b
LLM_MAX_TOKENS=80
# Small context keeps the 8B model inside 6 GB VRAM; keep it fixed across episode 3 comparisons
LLM_NUM_CTX=2048
# How long Ollama keeps the model loaded after the last request
OLLAMA_KEEP_ALIVE=30m

# faster-whisper on CPU (keeps VRAM free for the LLM): tiny | base | small
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=en

# Piper voice (https://huggingface.co/rhasspy/piper-voices)
PIPER_VOICE=en_US-lessac-medium
